generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ORGANIZER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum EventCategory {
  STANDUP
  ACTIVITY
  GAME
  MOVIE
}

enum EventGenre {
  COMEDY
  HORROR
  ACTION
  FUN
}

enum EventStatus {
  DRAFTED
  PUBLISHED
  ACTIVE
  CLOSED
  CANCELLED
}

enum RegistrationStatus {
  OPEN
  CLOSED
  SCHEDULED
}

enum BookingStatus {
  PARTIALLY_CANCELLED     
  CONFIRMED   
  CANCELLED
  EXPIRED
}

enum CancellationStatus {
  REFUND
  PENDING
}

model Users {
  id             String        @id @default(uuid()) @db.Uuid
  firstName      String
  lastName       String
  phoneNumber    String?
  email          String        @unique
  password       String
  role           Role          @default(USER)
  status         AccountStatus @default(ACTIVE)
  isEmailVeified Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  organizer      Organizer?
  venues         Venue[]
  emailOtp       EmailOtp?
  booking Booking[] @relation("User")
  cancellation  Cancellation[] 
}

model EmailOtp {
  id         String   @id @default(uuid())
  userId     String   @unique @db.Uuid
  codeHash   String
  attemps    Int      @default(0)
  lastSentAt DateTime @default(now())
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organizer {
  id                   String  @id @default(uuid()) @db.Uuid
  userid               String  @unique @db.Uuid
  displayName          String
  companyName          String
  alternatePhoneNumber String?
  addressLine1         String
  city                 String
  state                String
  country              String
  pincode              Int
  user                 Users   @relation(fields: [userid], references: [id], onDelete: Cascade)
  events               Event[]
}

model Venue {
  id String @id @default(uuid()) @db.Uuid

  venueName     String
  addressLine1  String
  city          String
  state         String
  country       String
  pincode       Int
  subVenueCount Int        @default(1)
  userId        String     @db.Uuid
  user          Users      @relation(fields: [userId], references: [id])
  subVenues     SubVenue[]

  @@index([userId])
}

model SubVenue {
  id             String         @id @default(uuid()) @db.Uuid
  venueId        String         @db.Uuid
  subVenueName   String?
  categoryCount  Int
  capacity       Int?
  seatCategories SeatCategory[]
  venue          Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessions       Session[]
}

model SeatCategory {
  id                    String                 @id @default(uuid()) @db.Uuid
  subVenueId            String                 @db.Uuid
  categoryName          String
  categoryDetail        String?
  seatCount             Int
  rowCount              Int?
  columnCount           Int?
  subVenue              SubVenue               @relation(fields: [subVenueId], references: [id], onDelete: Cascade)
  seatDetails           SeatDetail[]
  sessionCategoryPrices SessionCategoryPrice[]
}

model SeatDetail {
  id             String       @id @default(uuid()) @db.Uuid
  seatCategoryId String       @db.Uuid
  columnName     String
  columnNumber   Int
  rowNumber      Int
  seatCategory   SeatCategory @relation(fields: [seatCategoryId], references: [id], onDelete: Cascade)
}

model Event {
  id               String        @id @default(uuid()) @db.Uuid
  organizerId      String        @db.Uuid
  category         EventCategory
  genre            EventGenre
  Title            String
  Description      String?
  currentSessionId String?       @unique @db.Uuid
  imageUrl         String?
  status           EventStatus?  @default(DRAFTED)
  activeAt         DateTime?
  organizer        Organizer     @relation(fields: [organizerId], references: [id])
  sessions         Session[]
  currentSession   Session?      @relation("CurrentSession", fields: [currentSessionId], references: [id])
  @@index([status, activeAt])
}

model Session {
  id                    String                 @id @default(uuid()) @db.Uuid
  eventId               String                 @db.Uuid
  subVenueId            String                 @db.Uuid
  startDateTime         DateTime
  endDateTime           DateTime
  regStartdateTime      DateTime
  regEndDateTime        DateTime
  status                EventStatus        @default(DRAFTED)
  registrationStatus    RegistrationStatus @default(SCHEDULED)
  subVenue              SubVenue               @relation(fields: [subVenueId], references: [id])
  currentFor            Event?                 @relation("CurrentSession")
  event                 Event                  @relation(fields: [eventId], references: [id])
  sessionCategoryPrices SessionCategoryPrice[]
  booking Booking[]
  @@index([eventId, status])
  @@index([registrationStatus, regStartdateTime])
  @@index([registrationStatus, regEndDateTime])
}

model SessionCategoryPrice {
  id             String       @id @default(uuid()) @db.Uuid
  sessionId      String       @db.Uuid
  seatCategoryId String       @db.Uuid
  alias          String
  price          Decimal      @db.Decimal(10, 2)
  seatsForSale   Int
  session        Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seatCategory   SeatCategory @relation(fields: [seatCategoryId], references: [id])
  ticket Tickets[] 
  @@unique([sessionId, seatCategoryId])
  @@index([seatCategoryId])
}



model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  sessionId   String        @db.Uuid
  status      BookingStatus 
  totalAmount Decimal       @db.Decimal(10, 2)
  totalCount  Int
  paymentRef  String?      
  createdAt   DateTime      @default(now())
  user        Users @relation("User",fields:[userId], references: [id])
  session     Session       @relation(fields: [sessionId], references: [id])
  ticket       Tickets[]
  cancellation  Cancellation[]
}

model Tickets {
  id                     String   @id @default(uuid()) @db.Uuid
  bookingId              String   @db.Uuid
  sessionCategoryPriceId String   @db.Uuid
  status                 BookingStatus 
  unitPrice              Decimal  @db.Decimal(10, 2)  
  cancellationId         String?  @db.Uuid 
  booking                Booking  @relation(fields: [bookingId], references: [id])
  sessionCategoryPrice   SessionCategoryPrice @relation(fields: [sessionCategoryPriceId], references: [id])
  cancellation   Cancellation? @relation(fields: [cancellationId], references: [id])
  @@index([cancellationId])
}

model Cancellation {
  id           String      @id @default(uuid()) @db.Uuid
  bookingId    String      @db.Uuid
  userId       String      @db.Uuid
  ticketCount  Int
  refundAmount Decimal  @db.Decimal(10, 2)
  refundRef    String?
  status       CancellationStatus
  createdAt    DateTime @default(now())
  tickets      Tickets[]

  booking Booking @relation(fields: [bookingId], references: [id])
  user    Users   @relation(fields: [userId], references: [id])
  @@index([bookingId])
}